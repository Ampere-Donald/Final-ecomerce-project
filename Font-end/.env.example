# Frontend Client — Variables d'Environnement
# Copiez ce fichier en .env.local pour le développement local

# URL de l'API Backend (sans slash final)
VITE_API_URL=https://VOTRE-SERVICE.railway.app/api

# (optionnel) Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
