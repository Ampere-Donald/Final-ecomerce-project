model FactureVirtuelle {
  id                    String                   @id @default(uuid())
  numero                String                   @unique
  factureReelleId       String                   @unique @map("facture_reelle_id")
  venteId               String                   @unique @map("vente_id")
  clientId              String?                  @map("client_id")
  vendeurId             String                   @map("vendeur_id")
  approuveurId          String?                  @map("approuveur_id")
  dateCreation          DateTime                 @default(now()) @map("date_creation")
  dateApprobation       DateTime?                @map("date_approbation")
  pourcentageMajoration Decimal                  @map("pourcentage_majoration") @db.Decimal(5, 2)
  totalTTC              Decimal                  @map("total_ttc") @db.Decimal(12, 2)
  totalReelTTC          Decimal                  @map("total_reel_ttc") @db.Decimal(12, 2)
  margeDemarcheur       Decimal                  @map("marge_demarcheur") @db.Decimal(12, 2)
  modeMajoration        ModeMajoration           @default(GLOBAL) @map("mode_majoration")
  statut                StatutFactureVirtuelle   @default(EN_ATTENTE)
  motifRefus            String?                  @map("motif_refus")
  printCount            Int                      @default(0) @map("print_count")

  factureReelle         Facture                  @relation(fields: [factureReelleId], references: [id])
  vente                 Vente                    @relation(fields: [venteId], references: [id])
  client                Client?                  @relation(fields: [clientId], references: [id])
  vendeur               AdminUser                @relation("FacturesVirtuellesVendeur", fields: [vendeurId], references: [id])
  approuveur            AdminUser?               @relation("FacturesVirtuellesApprouveur", fields: [approuveurId], references: [id])
  lignes                FactureVirtuelleLigne[]

  @@map("facture_virtuelle")
}

model FactureVirtuelleLigne {
  id                    String             @id @default(uuid())
  factureVirtuelleId    String             @map("facture_virtuelle_id")
  nomProduit            String             @map("nom_produit") @db.VarChar(150)
  quantite              Int
  prixUnitaireReelTTC   Decimal            @map("prix_unitaire_reel_ttc") @db.Decimal(10, 2)
  pourcentageLigne      Decimal            @map("pourcentage_ligne") @db.Decimal(5, 2)
  prixUnitaireTTC       Decimal            @map("prix_unitaire_ttc") @db.Decimal(10, 2)
  sousTotalTTC          Decimal            @map("sous_total_ttc") @db.Decimal(12, 2)

