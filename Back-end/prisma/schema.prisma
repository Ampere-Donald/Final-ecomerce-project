generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Categorie {
  id          String    @id @default(uuid())
  nom         String    @unique @db.VarChar(100)
  description String?
  imageUrl    String?   @map("image_url")
  version     Int       @default(1)
  produits    Produit[]

  @@map("categorie")
}

model Produit {
  id                   String           @id @default(uuid())
  categorieId          String           @map("id_categorie")
  nomProduit           String           @map("nom_produit") @db.VarChar(150)
  marque               String?          @db.VarChar(100)
  description          String?
  dateAjout            DateTime         @default(now()) @map("date_ajout")
  version              Int              @default(1)
  imageUrl             String?          @map("image_url")
  prixDetail           Float?           @map("prix_detail")
  prixGros             Float?           @map("prix_gros")
  prixDemiGros         Float?           @map("prix_demi_gros")
  quantiteStock        Int              @default(0) @map("quantite_stock")
  seuilAlerte          Int              @default(5) @map("seuil_alerte")
  urlDatasheet         String?          @map("url_datasheet")
  finPromo             DateTime?        @map("fin_promo")
  isPopulaire          Boolean          @default(false) @map("is_populaire")
  prixPromo            Float?           @map("prix_promo")
  imageUrl2            String?          @map("image_url2")
  imageUrl3            String?          @map("image_url3")
  cmupActuel           Decimal          @default(0) @map("cmup_actuel") @db.Decimal(12, 2)
  dernierCoutAchatFcfa Decimal?         @map("dernier_cout_achat_fcfa") @db.Decimal(12, 2)
  derniereDeviseAchat  Devise?          @map("derniere_devise_achat")
  dernierFournisseurId String?          @map("dernier_fournisseur_id")
  dernierAchatAt       DateTime?        @map("dernier_achat_at")
  codeFamille          String?          @map("code_famille") @db.VarChar(50)
  code                 String?          @map("code") @db.VarChar(50)
  attributs            Attribut[]
  favoris              Favori[]
  lignesAchat          LigneAchat[]
  ligneBons            LigneBon[]
  lignesCommande       LigneCommande[]
  lignesVente          LigneVente[]
  mouvementsStock      MouvementStock[]
  mouvementsCmup       MouvementCmup[]
  categorie            Categorie        @relation(fields: [categorieId], references: [id])

  @@unique([marque, nomProduit], name: "unique_produit")
  @@unique([codeFamille, code], name: "unique_code_produit")
  @@map("produit")
}

model Attribut {
  id           String           @id @default(uuid())
  produitId    String           @map("id_produit")
  nomAttribut  String           @map("nom_attribut") @db.VarChar(100)
  typeAttribut TypeAttribut     @map("type_attribut")
  obligatoire  Boolean          @default(false)
  version      Int              @default(1)
  produit      Produit          @relation(fields: [produitId], references: [id])
  valeurs      ValeurAttribut[]

  @@unique([produitId, nomAttribut], name: "unique_attribut")
  @@map("attribut")
}

model ValeurAttribut {
  id         String   @id @default(uuid())
  attributId String   @map("id_attribut")
  valeur     String   @db.VarChar(100)
  version    Int      @default(1)
  attribut   Attribut @relation(fields: [attributId], references: [id], onDelete: Cascade)

  @@unique([attributId, valeur], name: "unique_valeur")
  @@map("valeur_attribut")
}

model Fournisseur {
  id            String   @id @default(uuid())
  nomEntreprise String   @map("nom_entreprise") @db.VarChar(150)
  contactNom    String?  @map("contact_nom") @db.VarChar(100)
  telephone     String?  @db.VarChar(20)
  email         String?  @db.VarChar(100)
  adresse       String?
  pays          String?  @db.VarChar(100)
  deviseDefaut  Devise   @default(FCFA) @map("devise_defaut")
  version       Int      @default(1)
  achats        Achat[]

  @@map("fournisseur")
}

model Client {
  id           String      @id @default(uuid())
  nom          String      @db.VarChar(100)
  prenom       String?     @db.VarChar(100)
  telephone    String?     @unique @db.VarChar(20)
  email        String?     @unique @db.VarChar(100)
  adresse      String?
  version      Int         @default(1)
  createdAt    DateTime    @default(now()) @map("created_at")
  emailVerifie Boolean     @default(false) @map("email_verifie")
  motDePasse   String?     @map("mot_de_passe")
  otpCode      String?     @map("otp_code")
  otpExpiresAt DateTime?   @map("otp_expires_at")
  typeClient   TypeClient  @default(PARTICULIER) @map("type_client")
  googleId     String?     @unique @map("google_id")
  bonsVente    BonVente[]
  commandes    Commande[]
  factures     Facture[]
  favoris      Favori[]
  ventes       Vente[]

  @@map("client")
}

model Achat {
  id                 String          @id @default(uuid())
  fournisseurId      String          @map("id_fournisseur")
  dateAchat          DateTime        @default(now()) @map("date_achat")
  devise             Devise          @default(FCFA)
  tauxChange         Decimal         @default(1) @map("taux_change") @db.Decimal(12, 6)
  dateTaux           DateTime?       @map("date_taux")
  sourceTaux         SourceTaux      @default(MANUEL) @map("source_taux")
  montantTotalDevise Decimal         @default(0) @map("montant_total_devise") @db.Decimal(12, 2)
  montantTotalFcfa   Decimal         @default(0) @map("montant_total_fcfa") @db.Decimal(12, 2)
  montantTotal       Decimal         @default(0) @map("montant_total") @db.Decimal(12, 2)
  statutPaiement     StatutPaiement  @default(NON_PAYE) @map("statut_paiement")
  statutAchat        StatutAchat     @default(BROUILLON) @map("statut_achat")
  validatedAt        DateTime?       @map("validated_at")
  validatedById      String?         @map("validated_by_id")
  annuleeAt          DateTime?       @map("annulee_at")
  annuleeById        String?         @map("annulee_by_id")
  motifAnnulation    String?         @map("motif_annulation") @db.VarChar(500)
  version            Int             @default(1)
  fournisseur        Fournisseur     @relation(fields: [fournisseurId], references: [id])
  caisses            Caisse[]
  lignesAchat        LigneAchat[]
  mouvementsCmup     MouvementCmup[]

  @@index([statutAchat])
  @@index([fournisseurId])
  @@map("achat")
}

model LigneAchat {
  id                     String         @id @default(uuid())
  achatId                String         @map("id_achat")
  produitId              String         @map("id_produit")
  quantite               Int
  prixUnitaireDevise     Decimal        @default(0) @map("prix_unitaire_devise") @db.Decimal(12, 2)
  sousTotalDevise        Decimal        @default(0) @map("sous_total_devise") @db.Decimal(12, 2)
  prixUnitaireFcfa       Decimal        @default(0) @map("prix_unitaire_fcfa") @db.Decimal(12, 2)
  sousTotalFcfa          Decimal        @default(0) @map("sous_total_fcfa") @db.Decimal(12, 2)
  coutUnitaireEntreeFcfa Decimal        @default(0) @map("cout_unitaire_entree_fcfa") @db.Decimal(12, 2)
  prixUnitaire           Decimal        @default(0) @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal              Decimal        @default(0) @map("sous_total") @db.Decimal(12, 2)
  stockAvant             Int?           @map("stock_avant")
  stockApres             Int?           @map("stock_apres")
  cmupAvant              Decimal?       @map("cmup_avant") @db.Decimal(12, 2)
  cmupApres              Decimal?       @map("cmup_apres") @db.Decimal(12, 2)
  version                Int            @default(1)
  achat                  Achat          @relation(fields: [achatId], references: [id], onDelete: Cascade)
  produit                Produit        @relation(fields: [produitId], references: [id])
  mouvementCmup          MouvementCmup?

  @@map("ligne_achat")
}

model TauxChange {
  id           String     @id @default(uuid())
  devise       Devise
  tauxVersFcfa Decimal    @map("taux_vers_fcfa") @db.Decimal(12, 6)
  source       SourceTaux
  fetchedAt    DateTime   @map("fetched_at")
  rawPayload   Json?      @map("raw_payload")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([devise, fetchedAt])
  @@map("taux_change")
}

model MouvementCmup {
  id               String      @id @default(uuid())
  produitId        String      @map("produit_id")
  achatId          String?     @map("achat_id")
  ligneAchatId     String?     @unique @map("ligne_achat_id")
  typeMouvement    String      @map("type_mouvement") @db.VarChar(50)
  devise           Devise
  tauxChange       Decimal     @map("taux_change") @db.Decimal(12, 6)
  quantiteEntree   Int         @map("quantite_entree")
  coutUnitaireFcfa Decimal     @map("cout_unitaire_fcfa") @db.Decimal(12, 2)
  stockAvant       Int         @map("stock_avant")
  stockApres       Int         @map("stock_apres")
  cmupAvant        Decimal     @map("cmup_avant") @db.Decimal(12, 2)
  cmupApres        Decimal     @map("cmup_apres") @db.Decimal(12, 2)
  createdById      String?     @map("created_by_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  produit          Produit     @relation(fields: [produitId], references: [id])
  achat            Achat?      @relation(fields: [achatId], references: [id])
  ligneAchat       LigneAchat? @relation(fields: [ligneAchatId], references: [id])

  @@index([produitId, createdAt])
  @@index([achatId])
  @@map("mouvement_cmup")
}

model BonVente {
  id              String          @id @default(uuid())
  numero          String          @unique
  vendeurId       String          @map("vendeur_id")
  clientId        String?         @map("client_id")
  methodePaiement MethodePaiement @map("methode_paiement")
  statut          StatutBon       @default(EN_ATTENTE)
  createdAt       DateTime        @default(now()) @map("created_at")
  valideeAt       DateTime?       @map("validee_at")
  valideeBy       String?         @map("validee_by")
  venteId         String?         @unique @map("vente_id")
  client          Client?         @relation(fields: [clientId], references: [id])
  validateur      AdminUser?      @relation("BonVenteValidateur", fields: [valideeBy], references: [id])
  vendeur         AdminUser       @relation("BonVenteVendeur", fields: [vendeurId], references: [id])
  vente           Vente?          @relation(fields: [venteId], references: [id])
  lignes          LigneBon[]

  @@map("bon_vente")
}

model LigneBon {
  id           String   @id @default(uuid())
  bonId        String   @map("bon_id")
  produitId    String   @map("produit_id")
  nomProduit   String   @map("nom_produit") @db.VarChar(150)
  quantite     Int
  prixUnitaire Decimal  @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal  @map("sous_total") @db.Decimal(12, 2)
  prixReference Decimal? @map("prix_reference") @db.Decimal(10, 2)
  bandePrix    String?  @map("bande_prix") @db.VarChar(20)
  motifRemise  String?  @map("motif_remise") @db.VarChar(255)
  bon          BonVente @relation(fields: [bonId], references: [id], onDelete: Cascade)
  produit      Produit  @relation(fields: [produitId], references: [id])

  @@map("ligne_bon")
}

model Facture {
  id              String          @id @default(uuid())
  numero          String          @unique
  type            TypeFacture
  ticketId        String?         @unique @map("ticket_id")
  venteId         String?         @unique @map("vente_id")
  clientId        String?         @map("client_id")
  vendeurId       String          @map("vendeur_id")
  caissierId      String?         @map("caissier_id")
  dateEmission    DateTime        @default(now()) @map("date_emission")
  totalHT         Decimal         @map("total_ht") @db.Decimal(12, 2)
  tva             Decimal         @db.Decimal(12, 2)
  totalTTC        Decimal         @map("total_ttc") @db.Decimal(12, 2)
  methodePaiement MethodePaiement @map("methode_paiement")
  printCount      Int             @default(0) @map("print_count")
  ticket          TicketVente?    @relation(fields: [ticketId], references: [id])
  vente           Vente?          @relation(fields: [venteId], references: [id])
  client          Client?         @relation(fields: [clientId], references: [id])
  vendeur         AdminUser       @relation("FacturesVendeur", fields: [vendeurId], references: [id])
  caissier        AdminUser?      @relation("FacturesCaissier", fields: [caissierId], references: [id])
  lignes          FactureLigne[]

  @@map("facture")
}

model FactureLigne {
  id              String  @id @default(uuid())
  factureId       String  @map("facture_id")
  nomProduit      String  @map("nom_produit") @db.VarChar(150)
  quantite        Int
  prixUnitaireHT  Decimal @map("prix_unitaire_ht") @db.Decimal(10, 2)
  prixUnitaireTTC Decimal @map("prix_unitaire_ttc") @db.Decimal(10, 2)
  sousTotalHT     Decimal @map("sous_total_ht") @db.Decimal(12, 2)
  sousTotalTTC    Decimal @map("sous_total_ttc") @db.Decimal(12, 2)
  facture         Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@map("facture_ligne")
}

model PrimeVendeur {
  id            String      @id @default(uuid())
  vendeurId     String      @map("vendeur_id")
  periode       String
  nombreTickets Int         @default(0) @map("nombre_tickets")
  statut        StatutPrime @default(EN_COURS)
  valideeById   String?     @map("validee_by")
  valideeAt     DateTime?   @map("validee_at")
  vendeur       AdminUser   @relation("PrimesVendeur", fields: [vendeurId], references: [id])
  valideeBy     AdminUser?  @relation("PrimesValidees", fields: [valideeById], references: [id])

  @@unique([vendeurId, periode])
  @@map("prime_vendeur")
}

model Vente {
  id              String          @id @default(uuid())
  clientId        String?         @map("id_client")
  dateVente       DateTime        @default(now()) @map("date_vente")
  montantTotal    Decimal         @map("montant_total") @db.Decimal(12, 2)
  montantPaye     Decimal         @default(0) @map("montant_paye") @db.Decimal(12, 2)
  methodePaiement MethodePaiement @map("methode_paiement")
  statutPaiement  StatutPaiement  @default(PAYE) @map("statut_paiement")
  vendeurId       String?         @map("vendeur_id")
  version         Int             @default(1)
  bonVente        BonVente?
  caisses         Caisse[]
  facture         Facture?
  lignesVente     LigneVente[]
  reglements      Reglement[]
  ticket          TicketVente?
  client          Client?         @relation(fields: [clientId], references: [id])
  vendeur         AdminUser?      @relation("VenteVendeur", fields: [vendeurId], references: [id])

  @@index([clientId, statutPaiement])
  @@map("vente")
}

model Reglement {
  id              String          @id @default(uuid())
  venteId         String          @map("id_vente")
  montant         Decimal         @db.Decimal(12, 2)
  methodePaiement MethodePaiement @map("methode_paiement")
  dateReglement   DateTime        @default(now()) @map("date_reglement")
  caissierId      String          @map("caissier_id")
  caisseJourId    String?         @map("caisse_jour_id")
  note            String?         @db.VarChar(255)
  annulee         Boolean         @default(false)
  motifAnnulation String?         @map("motif_annulation") @db.VarChar(255)
  annuleeById     String?         @map("annulee_by")
  annuleeAt       DateTime?       @map("annulee_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  vente           Vente           @relation(fields: [venteId], references: [id], onDelete: Cascade)
  caisses         Caisse[]

  @@index([venteId])
  @@map("reglement")
}

model TicketVente {
  id              String           @id @default(uuid())
  numeroTicket    String           @unique @map("numero_ticket") @db.VarChar(20)
  vendeurId       String           @map("vendeur_id")
  caissierId      String?          @map("caissier_id")
  clientId        String?          @map("client_id")
  nomClient       String?          @map("nom_client") @db.VarChar(150)
  telephoneClient String?          @map("telephone_client") @db.VarChar(30)
  montantTotal    Decimal          @map("montant_total") @db.Decimal(12, 2)
  methodePaiement MethodePaiement? @map("methode_paiement")
  statut          StatutTicket     @default(EN_ATTENTE)
  venteId         String?          @unique @map("vente_id")
  expiresAt       DateTime         @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  encaisseAt      DateTime?        @map("encaisse_at")
  annuleAt        DateTime?        @map("annule_at")
  motifAnnulation String?          @map("motif_annulation") @db.VarChar(255)
  lignes          LigneTicket[]
  vente           Vente?           @relation(fields: [venteId], references: [id])
  facture         Facture?
  vendeur         AdminUser        @relation("TicketsVendeur", fields: [vendeurId], references: [id])

  @@index([statut, expiresAt])
  @@index([vendeurId, createdAt])
  @@map("ticket_vente")
}

model LigneTicket {
  id           String      @id @default(uuid())
  ticketId     String      @map("ticket_id")
  produitId    String      @map("produit_id")
  nomProduit   String      @map("nom_produit") @db.VarChar(150)
  quantite     Int
  prixUnitaire Decimal     @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal     @map("sous_total") @db.Decimal(12, 2)
  prixReference Decimal?   @map("prix_reference") @db.Decimal(10, 2)
  bandePrix    String?     @map("bande_prix") @db.VarChar(20)
  motifRemise  String?     @map("motif_remise") @db.VarChar(255)
  ticket       TicketVente @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ligne_ticket")
}

model LigneVente {
  id           String  @id @default(uuid())
  venteId      String  @map("id_vente")
  quantite     Int
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal @map("sous_total") @db.Decimal(12, 2)
  version      Int     @default(1)
  produitId    String  @map("id_produit")
  prixReference Decimal? @map("prix_reference") @db.Decimal(10, 2)
  bandePrix    String?  @map("bande_prix") @db.VarChar(20)
  motifRemise  String?  @map("motif_remise") @db.VarChar(255)
  produit      Produit @relation(fields: [produitId], references: [id])
  vente        Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)

  @@map("ligne_vente")
}

model MouvementStock {
  id            String        @id @default(uuid())
  typeMouvement TypeMouvement @map("type_mouvement")
  quantite      Int
  dateMouvement DateTime      @default(now()) @map("date_mouvement")
  motif         String?       @db.VarChar(255)
  idReference   Int?          @map("id_reference")
  version       Int           @default(1)
  produitId     String        @map("id_produit")
  produit       Produit       @relation(fields: [produitId], references: [id])

  @@map("mouvement_stock")
}

model Caisse {
  id               String        @id @default(uuid())
  dateOperation    DateTime      @default(now()) @map("date_operation")
  typeOperation    TypeOperation @map("type_operation")
  montant          Decimal       @db.Decimal(12, 2)
  motif            String        @db.VarChar(255)
  venteId          String?       @map("id_vente")
  achatId          String?       @map("id_achat")
  reglementId      String?       @map("id_reglement")
  version          Int           @default(1)
  coffreId         String?       @map("id_coffre")
  caisseJourId     String?       @map("caisse_jour_id")
  transfertGroupId String?       @map("transfert_group_id")
  annulee          Boolean       @default(false)
  motifAnnulation  String?       @map("motif_annulation") @db.VarChar(255)
  annuleeById      String?       @map("annulee_by")
  annuleeAt        DateTime?     @map("annulee_at")
  effectueePar     String?       @map("effectuee_par")
  achat            Achat?        @relation(fields: [achatId], references: [id])
  operateur        AdminUser?    @relation("CaisseOperateur", fields: [effectueePar], references: [id])
  coffre           Coffre?       @relation("CoffreOperations", fields: [coffreId], references: [id])
  caisseJour       CaisseJour?   @relation("CaisseJourOperations", fields: [caisseJourId], references: [id])
  vente            Vente?        @relation(fields: [venteId], references: [id])
  reglement        Reglement?    @relation(fields: [reglementId], references: [id])

  @@index([coffreId])
  @@index([caisseJourId])
  @@index([transfertGroupId])
  @@index([reglementId])
  @@map("caisse")
}

model CaisseJour {
  id           String           @id @default(uuid())
  date         DateTime         @unique @db.Date
  ouvertureAt  DateTime         @map("ouverture_at")
  fermetureAt  DateTime?        @map("fermeture_at")
  caissierId   String?          @map("caissier_id")
  soldeCloture Decimal?         @map("solde_cloture") @db.Decimal(12, 2)
  statut       StatutCaisseJour @default(OUVERTE)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")
  operations   Caisse[]         @relation("CaisseJourOperations")

  @@index([statut])
  @@index([date])
  @@map("caisse_jour")
}

model Coffre {
  id              String       @id @default(uuid())
  nom             String       @db.VarChar(150)
  description     String?      @db.VarChar(500)
  objectifMontant Decimal?     @map("objectif_montant") @db.Decimal(12, 2)
  dateEcheance    DateTime?    @map("date_echeance")
  statut          CoffreStatut @default(ACTIF)
  createdById     String?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  operations      Caisse[]     @relation("CoffreOperations")
  echeances       Echeance[]

  @@map("coffre")
}

model Echeance {
  id               String             @id @default(uuid())
  titre            String             @db.VarChar(150)
  description      String?            @db.VarChar(500)
  coffreId         String?            @map("id_coffre")
  montantCible     Decimal?           @map("montant_cible") @db.Decimal(12, 2)
  dateEcheance     DateTime           @map("date_echeance")
  recurrence       RecurrenceEcheance @default(UNIQUE)
  joursAlerteAvant Int[]              @default([7, 3, 1]) @map("jours_alerte_avant")
  active           Boolean            @default(true)
  derniereAlerteLe DateTime?          @map("derniere_alerte_le")
  createdById      String?            @map("created_by")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")
  coffre           Coffre?            @relation(fields: [coffreId], references: [id])
  alertes          AlerteEcheance[]

  @@index([coffreId])
  @@index([active, dateEcheance])
  @@map("echeance")
}

model AlerteEcheance {
  id              String     @id @default(uuid())
  echeanceId      String     @map("id_echeance")
  type            TypeAlerte
  message         String     @db.VarChar(500)
  jourEmission    String     @map("jour_emission") @db.VarChar(10)
  emailEnvoye     Boolean    @default(false) @map("email_envoye")
  declencheManuel Boolean    @default(false) @map("declenche_manuel")
  createdAt       DateTime   @default(now()) @map("created_at")
  echeance        Echeance   @relation(fields: [echeanceId], references: [id], onDelete: Cascade)

  @@unique([echeanceId, type, jourEmission])
  @@index([echeanceId])
  @@map("alerte_echeance")
}

model Role {
  id      String @id @default(uuid())
  nom     String @db.VarChar(100)
  version Int    @default(1)

  @@map("role")
}

model Commande {
  id               String          @id @default(uuid())
  numeroSuivi      String          @unique @map("numero_suivi") @db.VarChar(30)
  nomClient        String          @map("nom_client") @db.VarChar(150)
  telephone        String          @db.VarChar(30)
  adresseLivraison String          @map("adresse_livraison")
  montantTotal     Decimal         @map("montant_total") @db.Decimal(12, 2)
  statut           StatutCommande  @default(EN_ATTENTE)
  dateCommande     DateTime        @default(now()) @map("date_commande")
  dateLivraison    DateTime?       @map("date_livraison")
  dateConfirmation DateTime?       @map("date_confirmation")
  dateAnnulation   DateTime?       @map("date_annulation")
  version          Int             @default(1)
  clientId         String?         @map("client_id")
  modeReception    ModeReception   @default(LIVRAISON) @map("mode_reception")
  client           Client?         @relation(fields: [clientId], references: [id])
  lignes           LigneCommande[]

  @@map("commande")
}

model Favori {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  produitId String   @map("produit_id")
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  produit   Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@unique([clientId, produitId])
  @@map("favori")
}

model LigneCommande {
  id           String   @id @default(uuid())
  commandeId   String   @map("id_commande")
  produitId    String   @map("id_produit")
  nomProduit   String   @map("nom_produit") @db.VarChar(150)
  quantite     Int
  prixUnitaire Decimal  @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal  @map("sous_total") @db.Decimal(12, 2)
  version      Int      @default(1)
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit      Produit  @relation(fields: [produitId], references: [id])

  @@map("ligne_commande")
}

model Notification {
  id        String           @id @default(uuid())
  type      TypeNotification
  message   String
  lue       Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")
  actorId   String?          @map("actor_id")
  actorName String?          @map("actor_name") @db.VarChar(100)
  actorRole String?          @map("actor_role") @db.VarChar(20)

  @@map("notification")
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter")
}

model PendingImport {
  id        String   @id @default(uuid())
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pending_import")
}

model SuggestionEquivalence {
  id               String   @id @default(uuid())
  query            String   @db.VarChar(255)
  produitVoulu     String?  @map("produit_voulu")
  produitsSuggeres Json     @map("produits_suggeres")
  vendeurId        String?  @map("vendeur_id")
  source           String   @default("pos") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("suggestion_equivalence")
}

model AdminUser {
  id          String         @id @default(uuid())
  email       String?        @unique @db.VarChar(100)
  username    String?        @unique @db.VarChar(50)
  motDePasse  String?        @map("mot_de_passe")
  pinCode     String?        @map("pin_code") @db.VarChar(255)
  nom         String         @db.VarChar(100)
  photoUrl    String?        @map("photo_url")
  role        AdminRole      @default(ADMIN)
  isActive    Boolean        @default(true) @map("is_active")
  peutVendreSousDemiGros Boolean @default(false) @map("peut_vendre_sous_demi_gros")
  lastLoginAt DateTime?      @map("last_login_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime?      @updatedAt @map("updated_at")
  createdById String?        @map("created_by")
  roleHistory RoleHistory[]
  activityLog ActivityLog[]
  bonsVenteVendeur    BonVente[]     @relation("BonVenteVendeur")
  bonsVenteValidateur BonVente[]     @relation("BonVenteValidateur")
  operationsCaisse    Caisse[]       @relation("CaisseOperateur")
  facturesVendeur     Facture[]      @relation("FacturesVendeur")
  facturesCaissier    Facture[]      @relation("FacturesCaissier")
  primesVendeur       PrimeVendeur[] @relation("PrimesVendeur")
  primesValidees      PrimeVendeur[] @relation("PrimesValidees")
  ticketsVendeur      TicketVente[]  @relation("TicketsVendeur")
  ventesEffectuees    Vente[]        @relation("VenteVendeur")

  @@map("admin_user")
}

model RoleHistory {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  oldRole     AdminRole @map("old_role")
  newRole     AdminRole @map("new_role")
  changedById String    @map("changed_by")
  changedAt   DateTime  @default(now()) @map("changed_at")
  motif       String?   @db.VarChar(255)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("role_history")
}

model ActivityLog {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  action      String    @db.VarChar(100)
  details     Json?
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@map("activity_log")
}

