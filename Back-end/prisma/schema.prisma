  libelle    String             @db.VarChar(150)
  base       Decimal?           @db.Decimal(12, 2)
  taux       Decimal?           @db.Decimal(6, 3)
  montant    Decimal            @default(0) @db.Decimal(12, 2)
  ordre      Int                @default(0)
  systeme    Boolean            @default(false)
  bulletin   BulletinPaie       @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  @@index([bulletinId])
  @@map("bulletin_ligne")
}

enum TypeContrat {
  CDI
  CDD
  STAGE
  INTERIM
  TACHERON
}

enum StatutBulletin {
  BROUILLON
  VALIDE
  PAYE
  ANNULE
}

enum TypeLigneBulletin {
  GAIN
  RETENUE
}

