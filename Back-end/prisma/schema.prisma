// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. CLASSIFICATION SIMPLE
model Categorie {
  id          String    @id @default(uuid())
  nom         String    @unique @db.VarChar(100)
  description String?   @db.Text
  version     Int       @default(1)
  produits    Produit[]

  @@map("categorie")
}

// 2. PRODUIT GÉNÉRIQUE (BASE)
model Produit {
  id          String            @id @default(uuid())
  categorieId String            @map("id_categorie")
  nomProduit  String            @map("nom_produit") @db.VarChar(150)
  marque      String            @db.VarChar(100)
  imageUrl    String?           @map("image_url") @db.Text
  description String?           @db.Text
  dateAjout   DateTime          @default(now()) @map("date_ajout")
  version     Int               @default(1)
  categorie   Categorie         @relation(fields: [categorieId], references: [id])
  attributs   Attribut[]
  variantes   VarianteProduit[]

  @@unique([marque, nomProduit], name: "unique_produit")
  @@map("produit")
}

// 3. ATTRIBUTS PRODUIT
enum TypeAttribut {
  TEXTE
  NOMBRE
  LISTE
}

model Attribut {
  id            String                    @id @default(uuid())
  produitId     String                    @map("id_produit")
  nomAttribut   String                    @map("nom_attribut") @db.VarChar(100)
  typeAttribut  TypeAttribut              @map("type_attribut")
  obligatoire   Boolean                   @default(false)
  version       Int                       @default(1)
  produit       Produit                   @relation(fields: [produitId], references: [id])
  valeurs       ValeurAttribut[]
  varianteAttrs VarianteProduitAttribut[]

  @@unique([produitId, nomAttribut], name: "unique_attribut")
  @@map("attribut")
}

// 4. VALEURS POSSIBLES POUR LES ATTRIBUTS
model ValeurAttribut {
  id            String                    @id @default(uuid())
  attributId    String                    @map("id_attribut")
  valeur        String                    @db.VarChar(100)
  version       Int                       @default(1)
  attribut      Attribut                  @relation(fields: [attributId], references: [id], onDelete: Cascade)
  varianteAttrs VarianteProduitAttribut[]

  @@unique([attributId, valeur], name: "unique_valeur")
  @@map("valeur_attribut")
}

// 5. VARIANTE DE PRODUIT
model VarianteProduit {
  id               String                    @id @default(uuid())
  produitId        String                    @map("id_produit")
  codeVariante     String                    @unique @map("code_variante") @db.VarChar(50)
  codeBarre        String?                   @unique @map("code_barre") @db.VarChar(50)
  prixAchat        Decimal                   @map("prix_achat") @db.Decimal(10, 2)
  prixVente        Decimal                   @map("prix_vente") @db.Decimal(10, 2)
  quantiteStock    Int                       @default(0) @map("quantite_stock")
  seuilAlerte      Int                       @default(5) @map("seuil_alerte")
  dateAjout        DateTime                  @default(now()) @map("date_ajout")
  actif            Boolean                   @default(true)
  version          Int                       @default(1)
  produit          Produit                   @relation(fields: [produitId], references: [id], onDelete: Cascade)
  attributs        VarianteProduitAttribut[]
  lignesAchat      LigneAchat[]
  lignesVente      LigneVente[]
  mouvementsStock  MouvementStock[]

  @@map("variante_produit")
}

// 6. DÉTAIL DE CHAQUE VARIANTE (Attributs appliqués)
model VarianteProduitAttribut {
  id                  String           @id @default(uuid())
  varianteProduitId   String           @map("id_variante_produit")
  attributId          String           @map("id_attribut")
  valeurId            String?          @map("id_valeur")
  valeurPersonnalisee String?          @map("valeur_personnalisee") @db.VarChar(100)
  version             Int              @default(1)
  varianteProduit     VarianteProduit  @relation(fields: [varianteProduitId], references: [id], onDelete: Cascade)
  attribut            Attribut         @relation(fields: [attributId], references: [id])
  valeur              ValeurAttribut?  @relation(fields: [valeurId], references: [id])

  @@unique([varianteProduitId, attributId], name: "unique_variante_attribut")
  @@map("variante_produit_attribut")
}

// 7. GESTION DES TIERS - FOURNISSEUR
model Fournisseur {
  id           String  @id @default(uuid())
  nomEntreprise String  @map("nom_entreprise") @db.VarChar(150)
  contactNom   String? @map("contact_nom") @db.VarChar(100)
  telephone    String? @db.VarChar(20)
  email        String? @db.VarChar(100)
  adresse      String? @db.Text
  version      Int     @default(1)
  achats       Achat[]

  @@map("fournisseur")
}

// 8. GESTION DES TIERS - CLIENT
model Client {
  id        String  @id @default(uuid())
  nom       String  @db.VarChar(100)
  prenom    String? @db.VarChar(100)
  telephone String? @db.VarChar(20)
  email     String? @db.VarChar(100)
  adresse   String? @db.Text
  version   Int     @default(1)
  ventes    Vente[]

  @@map("client")
}

// 9. GESTION DES ACHATS
enum StatutPaiement {
  PAYE
  PARTIEL
  NON_PAYE
}

model Achat {
  id             String         @id @default(uuid())
  fournisseurId  String         @map("id_fournisseur")
  dateAchat      DateTime       @default(now()) @map("date_achat")
  montantTotal   Decimal        @map("montant_total") @db.Decimal(12, 2)
  statutPaiement StatutPaiement @default(NON_PAYE) @map("statut_paiement")
  version        Int            @default(1)
  fournisseur    Fournisseur    @relation(fields: [fournisseurId], references: [id])
  lignesAchat    LigneAchat[]
  caisses        Caisse[]

  @@map("achat")
}

// 10. LIGNES D'ACHAT
model LigneAchat {
  id               String          @id @default(uuid())
  achatId          String          @map("id_achat")
  varianteProduitId String         @map("id_variante_produit")
  quantite         Int
  prixUnitaire     Decimal         @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal        Decimal         @map("sous_total") @db.Decimal(12, 2)
  version          Int             @default(1)
  achat            Achat           @relation(fields: [achatId], references: [id], onDelete: Cascade)
  varianteProduit  VarianteProduit @relation(fields: [varianteProduitId], references: [id])

  @@map("ligne_achat")
}

// 11. GESTION DES VENTES
enum MethodePaiement {
  ESPECES
  CARTE
  VIREMENT
  MOBILE_MONEY
}

model Vente {
  id              String          @id @default(uuid())
  clientId        String?         @map("id_client")
  dateVente       DateTime        @default(now()) @map("date_vente")
  montantTotal    Decimal         @map("montant_total") @db.Decimal(12, 2)
  methodePaiement MethodePaiement @map("methode_paiement")
  statutPaiement  StatutPaiement  @default(PAYE) @map("statut_paiement")
  version         Int             @default(1)
  client          Client?         @relation(fields: [clientId], references: [id])
  lignesVente     LigneVente[]
  caisses         Caisse[]

  @@map("vente")
}

// 12. LIGNES DE VENTE
model LigneVente {
  id               String          @id @default(uuid())
  venteId          String          @map("id_vente")
  varianteProduitId String         @map("id_variante_produit")
  quantite         Int
  prixUnitaire     Decimal         @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal        Decimal         @map("sous_total") @db.Decimal(12, 2)
  version          Int             @default(1)
  vente            Vente           @relation(fields: [venteId], references: [id], onDelete: Cascade)
  varianteProduit  VarianteProduit @relation(fields: [varianteProduitId], references: [id])

  @@map("ligne_vente")
}

// 13. GESTION DES MOUVEMENTS DE STOCK
enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  RETOUR
}

model MouvementStock {
  id               String          @id @default(uuid())
  varianteProduitId String         @map("id_variante_produit")
  typeMouvement    TypeMouvement   @map("type_mouvement")
  quantite         Int
  dateMouvement    DateTime        @default(now()) @map("date_mouvement")
  motif            String?         @db.VarChar(255)
  idReference      Int?            @map("id_reference")
  version          Int             @default(1)
  varianteProduit  VarianteProduit @relation(fields: [varianteProduitId], references: [id])

  @@map("mouvement_stock")
}

// 14. GESTION DE LA CAISSE ET COMPTABILITÉ
enum TypeOperation {
  ENTREE
  SORTIE
}

model Caisse {
  id            String        @id @default(uuid())
  dateOperation DateTime      @default(now()) @map("date_operation")
  typeOperation TypeOperation @map("type_operation")
  montant       Decimal       @db.Decimal(12, 2)
  motif         String        @db.VarChar(255)
  venteId       String?       @map("id_vente")
  achatId       String?       @map("id_achat")
  version       Int           @default(1)
  vente         Vente?        @relation(fields: [venteId], references: [id])
  achat         Achat?        @relation(fields: [achatId], references: [id])

  @@map("caisse")
}

// 15. GESTION DES RÔLES
model Role {
  id      String @id @default(uuid())
  nom     String @db.VarChar(100)
  version Int    @default(1)

  @@map("role")
}
