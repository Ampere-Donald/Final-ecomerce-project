generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Categorie {
  id          String    @id @default(uuid())
  nom         String    @unique @db.VarChar(100)
  description String?
  imageUrl    String?   @map("image_url")
  version     Int       @default(1)
  produits    Produit[]

  @@map("categorie")
}

model Produit {
  id              String           @id @default(uuid())
  categorieId     String           @map("id_categorie")
  nomProduit      String           @map("nom_produit") @db.VarChar(150)
  marque          String?          @db.VarChar(100)
  description     String?
  dateAjout       DateTime         @default(now()) @map("date_ajout")
  version         Int              @default(1)
  imageUrl        String?          @map("image_url")
  prixDetail      Float?           @map("prix_detail")
  prixGros        Float?           @map("prix_gros")
  quantiteStock   Int              @default(0) @map("quantite_stock")
  seuilAlerte     Int              @default(5) @map("seuil_alerte")
  urlDatasheet    String?          @map("url_datasheet")
  finPromo        DateTime?        @map("fin_promo")
  isPopulaire     Boolean          @default(false) @map("is_populaire")
  prixPromo       Float?           @map("prix_promo")
  imageUrl2       String?          @map("image_url2")
  imageUrl3       String?          @map("image_url3")
  attributs       Attribut[]
  favoris         Favori[]
  lignesAchat     LigneAchat[]
  lignesCommande  LigneCommande[]
  lignesVente     LigneVente[]
  mouvementsStock MouvementStock[]
  categorie       Categorie        @relation(fields: [categorieId], references: [id])

  @@unique([marque, nomProduit], name: "unique_produit")
  @@map("produit")
}

model Attribut {
  id           String           @id @default(uuid())
  produitId    String           @map("id_produit")
  nomAttribut  String           @map("nom_attribut") @db.VarChar(100)
  typeAttribut TypeAttribut     @map("type_attribut")
  obligatoire  Boolean          @default(false)
  version      Int              @default(1)
  produit      Produit          @relation(fields: [produitId], references: [id])
  valeurs      ValeurAttribut[]

  @@unique([produitId, nomAttribut], name: "unique_attribut")
  @@map("attribut")
}

model ValeurAttribut {
  id         String   @id @default(uuid())
  attributId String   @map("id_attribut")
  valeur     String   @db.VarChar(100)
  version    Int      @default(1)
  attribut   Attribut @relation(fields: [attributId], references: [id], onDelete: Cascade)

  @@unique([attributId, valeur], name: "unique_valeur")
  @@map("valeur_attribut")
}

model Fournisseur {
  id            String  @id @default(uuid())
  nomEntreprise String  @map("nom_entreprise") @db.VarChar(150)
  contactNom    String? @map("contact_nom") @db.VarChar(100)
  telephone     String? @db.VarChar(20)
  email         String? @db.VarChar(100)
  adresse       String?
  version       Int     @default(1)
  achats        Achat[]

  @@map("fournisseur")
}

model Client {
  id           String     @id @default(uuid())
  nom          String     @db.VarChar(100)
  prenom       String?    @db.VarChar(100)
  telephone    String?    @unique @db.VarChar(20)
  email        String?    @unique @db.VarChar(100)
  adresse      String?
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  emailVerifie Boolean    @default(false) @map("email_verifie")
  motDePasse   String?    @map("mot_de_passe")
  otpCode      String?    @map("otp_code")
  otpExpiresAt DateTime?  @map("otp_expires_at")
  typeClient   TypeClient @default(PARTICULIER) @map("type_client")
  googleId     String?    @unique @map("google_id")
  commandes    Commande[]
  favoris      Favori[]
  ventes       Vente[]

  @@map("client")
}

model Achat {
  id             String         @id @default(uuid())
  fournisseurId  String         @map("id_fournisseur")
  dateAchat      DateTime       @default(now()) @map("date_achat")
  montantTotal   Decimal        @map("montant_total") @db.Decimal(12, 2)
  statutPaiement StatutPaiement @default(NON_PAYE) @map("statut_paiement")
  version        Int            @default(1)
  fournisseur    Fournisseur    @relation(fields: [fournisseurId], references: [id])
  caisses        Caisse[]
  lignesAchat    LigneAchat[]

  @@map("achat")
}

model LigneAchat {
  id           String  @id @default(uuid())
  achatId      String  @map("id_achat")
  quantite     Int
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal @map("sous_total") @db.Decimal(12, 2)
  version      Int     @default(1)
  produitId    String  @map("id_produit")
  achat        Achat   @relation(fields: [achatId], references: [id], onDelete: Cascade)
  produit      Produit @relation(fields: [produitId], references: [id])

  @@map("ligne_achat")
}

model Vente {
  id              String          @id @default(uuid())
  clientId        String?         @map("id_client")
  dateVente       DateTime        @default(now()) @map("date_vente")
  montantTotal    Decimal         @map("montant_total") @db.Decimal(12, 2)
  methodePaiement MethodePaiement @map("methode_paiement")
  statutPaiement  StatutPaiement  @default(PAYE) @map("statut_paiement")
  version         Int             @default(1)
  caisses         Caisse[]
  lignesVente     LigneVente[]
  client          Client?         @relation(fields: [clientId], references: [id])

  @@map("vente")
}

model LigneVente {
  id           String  @id @default(uuid())
  venteId      String  @map("id_vente")
  quantite     Int
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal @map("sous_total") @db.Decimal(12, 2)
  version      Int     @default(1)
  produitId    String  @map("id_produit")
  produit      Produit @relation(fields: [produitId], references: [id])
  vente        Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)

  @@map("ligne_vente")
}

model MouvementStock {
  id            String        @id @default(uuid())
  typeMouvement TypeMouvement @map("type_mouvement")
  quantite      Int
  dateMouvement DateTime      @default(now()) @map("date_mouvement")
  motif         String?       @db.VarChar(255)
  idReference   Int?          @map("id_reference")
  version       Int           @default(1)
  produitId     String        @map("id_produit")
  produit       Produit       @relation(fields: [produitId], references: [id])

  @@map("mouvement_stock")
}

model Caisse {
  id            String        @id @default(uuid())
  dateOperation DateTime      @default(now()) @map("date_operation")
  typeOperation TypeOperation @map("type_operation")
  montant       Decimal       @db.Decimal(12, 2)
  motif         String        @db.VarChar(255)
  venteId       String?       @map("id_vente")
  achatId       String?       @map("id_achat")
  version       Int           @default(1)
  coffreId          String?       @map("id_coffre")
  transfertGroupId  String?       @map("transfert_group_id")
  annulee           Boolean       @default(false)
  motifAnnulation   String?       @db.VarChar(255) @map("motif_annulation")
  annuleeById       String?       @map("annulee_by")
  annuleeAt         DateTime?     @map("annulee_at")
  effectueePar      String?       @map("effectuee_par")
  achat         Achat?        @relation(fields: [achatId], references: [id])
  coffre        Coffre?       @relation("CoffreOperations", fields: [coffreId], references: [id])
  vente         Vente?        @relation(fields: [venteId], references: [id])

  @@index([coffreId])
  @@index([transfertGroupId])
  @@map("caisse")
}

model Coffre {
  id              String       @id @default(uuid())
  nom             String       @db.VarChar(150)
  description     String?      @db.VarChar(500)
  objectifMontant Decimal?     @db.Decimal(12, 2) @map("objectif_montant")
  dateEcheance    DateTime?    @map("date_echeance")
  statut          CoffreStatut @default(ACTIF)
  createdById     String?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  operations      Caisse[]     @relation("CoffreOperations")
  echeances       Echeance[]

  @@map("coffre")
}

model Echeance {
  id               String             @id @default(uuid())
  titre            String             @db.VarChar(150)
  description      String?            @db.VarChar(500)
  coffreId         String?            @map("id_coffre")
  montantCible     Decimal?           @map("montant_cible") @db.Decimal(12, 2)
  dateEcheance     DateTime           @map("date_echeance")
  recurrence       RecurrenceEcheance @default(UNIQUE)
  joursAlerteAvant Int[]              @default([7, 3, 1]) @map("jours_alerte_avant")
  active           Boolean            @default(true)
  derniereAlerteLe DateTime?          @map("derniere_alerte_le")
  createdById      String?            @map("created_by")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  coffre           Coffre?            @relation(fields: [coffreId], references: [id])
  alertes          AlerteEcheance[]

  @@index([coffreId])
  @@index([active, dateEcheance])
  @@map("echeance")
}

model AlerteEcheance {
  id              String     @id @default(uuid())
  echeanceId      String     @map("id_echeance")
  type            TypeAlerte
  message         String     @db.VarChar(500)
  jourEmission    String     @map("jour_emission") @db.VarChar(10)
  emailEnvoye     Boolean    @default(false) @map("email_envoye")
  declencheManuel Boolean    @default(false) @map("declenche_manuel")
  createdAt       DateTime   @default(now()) @map("created_at")
  echeance        Echeance   @relation(fields: [echeanceId], references: [id], onDelete: Cascade)

  @@unique([echeanceId, type, jourEmission])
  @@index([echeanceId])
  @@map("alerte_echeance")
}

model Role {
  id      String @id @default(uuid())
  nom     String @db.VarChar(100)
  version Int    @default(1)

  @@map("role")
}

model Commande {
  id               String          @id @default(uuid())
  numeroSuivi      String          @unique @map("numero_suivi") @db.VarChar(30)
  nomClient        String          @map("nom_client") @db.VarChar(150)
  telephone        String          @db.VarChar(30)
  adresseLivraison String          @map("adresse_livraison")
  montantTotal     Decimal         @map("montant_total") @db.Decimal(12, 2)
  statut           StatutCommande  @default(EN_ATTENTE)
  dateCommande     DateTime        @default(now()) @map("date_commande")
  dateLivraison    DateTime?       @map("date_livraison")
  dateConfirmation DateTime?       @map("date_confirmation")
  dateAnnulation   DateTime?       @map("date_annulation")
  version          Int             @default(1)
  clientId         String?         @map("client_id")
  modeReception    ModeReception   @default(LIVRAISON) @map("mode_reception")
  client           Client?         @relation(fields: [clientId], references: [id])
  lignes           LigneCommande[]

  @@map("commande")
}

model Favori {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  produitId String   @map("produit_id")
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  produit   Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@unique([clientId, produitId])
  @@map("favori")
}

model LigneCommande {
  id           String   @id @default(uuid())
  commandeId   String   @map("id_commande")
  produitId    String   @map("id_produit")
  nomProduit   String   @map("nom_produit") @db.VarChar(150)
  quantite     Int
  prixUnitaire Decimal  @map("prix_unitaire") @db.Decimal(10, 2)
  sousTotal    Decimal  @map("sous_total") @db.Decimal(12, 2)
  version      Int      @default(1)
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit      Produit  @relation(fields: [produitId], references: [id])

  @@map("ligne_commande")
}

model Notification {
  id        String           @id @default(uuid())
  type      TypeNotification
  message   String
  lue       Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")
  actorId   String?          @map("actor_id")
  actorName String?          @map("actor_name") @db.VarChar(100)
  actorRole String?          @map("actor_role") @db.VarChar(20)

  @@map("notification")
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter")
}

enum TypeAttribut {
  TEXTE
  NOMBRE
  LISTE
}

enum TypeClient {
  PARTICULIER
  PROFESSIONNEL
}

enum StatutPaiement {
  PAYE
  PARTIEL
  NON_PAYE
}

enum MethodePaiement {
  ESPECES
  CARTE
  VIREMENT
  MOBILE_MONEY
}

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  RETOUR
}

enum TypeOperation {
  ENTREE
  SORTIE
}

enum CoffreStatut {
  ACTIF
  ATTEINT
  CLOTURE
}

enum RecurrenceEcheance {
  UNIQUE
  MENSUELLE
  TRIMESTRIELLE
  ANNUELLE
}

enum TypeAlerte {
  RAPPEL
  URGENT
  RETARD
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum ModeReception {
  LIVRAISON
  RETRAIT_MAGASIN
}

enum TypeNotification {
  COMMANDE_CREEE
  COMMANDE_STATUT
  PRODUIT_CREE
  PRODUIT_MAJ
  PRODUIT_SUPPRIME
  STOCK_CHANGE
  CATEGORIE_CREEE
  CATEGORIE_MAJ
  CATEGORIE_SUPPRIMEE
  VENTE_CREEE
  VENTE_MAJ
  ACHAT_CREE
  ACHAT_MAJ
  ACHAT_SUPPRIME
  COMPTE_CREE
  COMPTE_MAJ
  COMPTE_SUPPRIME
  FOURNISSEUR_CREE
  FOURNISSEUR_MAJ
  FOURNISSEUR_SUPPRIME
  CAISSE_CREEE
  CAISSE_MAJ
  CAISSE_SUPPRIMEE
  MOUVEMENT_STOCK_CREE
  ECHEANCE
}

model PendingImport {
  id        String   @id @default(uuid())
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pending_import")
}

model AdminUser {
  id          String        @id @default(uuid())
  email       String?       @unique @db.VarChar(100)
  username    String        @unique @db.VarChar(50)
  motDePasse  String?       @map("mot_de_passe")
  pinCode     String?       @map("pin_code") @db.VarChar(255)
  nom         String        @db.VarChar(100)
  photoUrl    String?       @map("photo_url")
  role        AdminRole     @default(ADMIN)
  isActive    Boolean       @default(true) @map("is_active")
  lastLoginAt DateTime?     @map("last_login_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  createdById String?       @map("created_by")
  roleHistory RoleHistory[]
  activityLog ActivityLog[]

  @@map("admin_user")
}

model RoleHistory {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  oldRole     AdminRole @map("old_role")
  newRole     AdminRole @map("new_role")
  changedById String    @map("changed_by")
  changedAt   DateTime  @default(now()) @map("changed_at")
  motif       String?   @db.VarChar(255)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("role_history")
}

model ActivityLog {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  action      String    @db.VarChar(100)
  details     Json?
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@map("activity_log")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CAISSIER
  VENDEUR
  MANAGER
}
