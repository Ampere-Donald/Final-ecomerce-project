DATABASE_URL="postgresql://postgres:password@localhost:5432/ecommerce?schema=public"
JWT_SECRET="ton-super-secret-256-bits-minimum"
DB_NAME=ecommerce
DB_USER=postgres
DB_PASS=password
PORT=3000
NODE_ENV=production

# Guest tracking recovery. Off until a real SMTP sender is configured and tested.
GUEST_EMAIL_ENABLED=false
# Anonymous journey counters. Off until browser hooks, admin report and pilot are reviewed.
PARCOURS_METRICS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NEWOTEG SARL <noreply@newoteg.com>"

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini (équivalences de pièces — clé gratuite via Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
# Optionnel : modèle Gemini (défaut gemini-2.5-flash ; éviter gemini-2.0-flash dont le quota free-tier peut être nul)
GEMINI_MODEL=gemini-2.5-flash
