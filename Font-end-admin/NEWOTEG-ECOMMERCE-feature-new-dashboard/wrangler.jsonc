{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "newoteg-admin",
  "main": "worker.js",
  "compatibility_date": "2026-06-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*",
      "/downloads/Newoteg-Printer-Setup.exe"
    ]
  }
}
